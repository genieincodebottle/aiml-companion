# Live mode only. Replay mode needs nothing in this file at all.
#
# Free key at https://aistudio.google.com/apikey
# Never commit a real key. This file is the example, .env is yours and is ignored.
# Either name works. GOOGLE_API_KEY is checked first.
GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_API_KEY=your_google_api_key_here

# Force replay mode even when a key is present. Useful for recording.
REPLAY_ONLY=false

# Model ids move. These override the defaults in backend/app/config.py.
# ORCHESTRATOR_MODEL=gemini-3.1-pro-preview
# WORKER_MODEL=gemini-3.6-flash
# CLASSIFIER_MODEL=gemini-3.5-flash-lite
