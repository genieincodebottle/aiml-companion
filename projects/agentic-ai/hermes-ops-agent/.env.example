# Copy to ~/.hermes/.env and chmod 600. This project never reads it; Hermes does.
#
# Pick ONE provider. All of these clear the 64k context floor.

# Nous Portal (easiest: `hermes setup --portal` does OAuth, no key to paste)

# Google Gemini free tier - https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# OpenRouter - https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Anthropic - https://console.anthropic.com
# ANTHROPIC_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
# OPENAI_API_KEY=
