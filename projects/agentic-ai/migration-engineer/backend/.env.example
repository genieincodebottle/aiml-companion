# Copy to .env. Everything here is OPTIONAL - the demo runs with none of it.
#
# Worker mode:
#   - No API key            -> deterministic offline worker ("stub" mode)
#   - ANTHROPIC_API_KEY set + `uv sync --extra sdk` -> real Claude Agent SDK
#   - GEMINI_API_KEY set + `pip install google-genai` -> Gemini function-calling worker
# Target mode:
#   - No GITHUB_TOKEN       -> only the built-in fixture job runs (real git, local remote)
#   - GITHUB_TOKEN + ME_TARGET_REPOS -> a "github-fleet" job that migrates YOUR real repos

# --- Claude Agent SDK worker -------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ME_MODEL=claude-sonnet-5
# ME_FORCE_STUB=1            # force the offline worker even with a key (CI/tests)

# --- Gemini live worker (fallback when no ANTHROPIC_API_KEY) -----------------
# Also honoured from the monorepo root .env (GEMINI_API_KEY or GOOGLE_API_KEY).
# GEMINI_API_KEY=AIza...
# ME_GEMINI_MODEL=gemini-2.5-flash

# --- Real GitHub repositories ------------------------------------------------
# A fine-grained PAT (or GitHub App installation token) with, on the target repos:
#   Contents: Read and write   |   Pull requests: Read and write
# GITHUB_TOKEN=github_pat_...
# ME_TARGET_REPOS=my-org/service-a,my-org/service-b   # comma-separated owner/name
# ME_TARGET_RULE=modernize-datetime                    # a rule id from the rulebook
# ME_TEST_COMMAND=python -m pytest -q                  # the repo's real test command
# ME_BASE_BRANCH=main

# --- Per-repo budget ceilings ------------------------------------------------
# ME_MAX_AGENT_STEPS=12
# ME_MAX_TOOL_CALLS=60
# ME_MAX_COST_USD=0.75

# --- Fleet orchestration -----------------------------------------------------
# ME_FAN_OUT=3
# ME_AUTO_APPROVE=false       # keep false: real PRs wait for a human

# --- Teaching flag (docs/EXERCISES.md #3) - NEVER in production ---------------
# ME_DISABLE_GUARDRAILS=1     # turn off hook layer 1; watch the reviewer catch tampering

# --- Server ------------------------------------------------------------------
# ME_PORT=8000
# ME_CORS_ORIGINS=http://localhost:5173
