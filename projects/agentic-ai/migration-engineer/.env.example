# Used by docker-compose (copy to .env in this folder, then `docker compose up`).
# All OPTIONAL - the demo runs the fixture job on real git with none of these.

# Drive the real Claude Agent SDK worker instead of the deterministic stub
# (also requires adding `claude-agent-sdk` to the backend image):
# ANTHROPIC_API_KEY=sk-ant-...

# Or drive the Gemini live worker (works out of the box - google-genai is in the image):
# GEMINI_API_KEY=AIza...
# ME_GEMINI_MODEL=gemini-2.5-flash

# Migrate your REAL GitHub repos (fine-grained PAT: contents + pull_requests write):
# GITHUB_TOKEN=github_pat_...
# ME_TARGET_REPOS=my-org/service-a,my-org/service-b
# ME_TARGET_RULE=modernize-datetime
# ME_TEST_COMMAND=python -m pytest -q
