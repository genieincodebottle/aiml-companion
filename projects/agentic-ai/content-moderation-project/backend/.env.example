# Gemini API key. OPTIONAL.
#
# Without it the project runs in offline mode: the agents talk to a
# deterministic rule engine instead of a model, so `python run.py demo`, the
# test suite and even the API all work with no key at all. Set one when you
# want real analysis.
#
# Free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Force offline mode even when a key IS present. Useful for running the demo
# or the tests without spending tokens.
MODERATION_OFFLINE=false

# Fast Mode - single-pass moderation for short comments (skip full 6-agent pipeline)
#
# This is the most consequential setting here. The fast path never loads user
# reputation and never evaluates a HITL trigger, so it cannot suspend a repeat
# offender or escalate a high-profile account. Compare `python run.py demo`
# with `python run.py fast` before turning it on.
ENABLE_FAST_MODE=true
FAST_MODE_MAX_LENGTH=200
FAST_MODE_CONTENT_TYPES=story_comment

# ML Models - set to true for hybrid ML+LLM toxicity detection.
# Requires `pip install -r requirements-ml.txt` first (torch is not in the
# default requirements), then downloads ~500MB of model files on first run.
USE_ML_MODELS=false
ML_PRIMARY_MODEL=distilbert_toxic
ML_USE_ENSEMBLE=false
ML_PRELOAD_MODELS=true
ML_DEVICE=auto
