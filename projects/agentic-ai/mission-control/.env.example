# Mission Control: settings for `docker compose up`. Copy to .env. All optional.
# GOOGLE_API_KEY=your-key-here      # use Gemini (else offline mode). Free key: https://aistudio.google.com/apikey
# MC_MODE=auto                       # auto | offline | live (live refuses to run without a key)
# MC_OPERATORS=ana:analyst:long-random-token,rex:reviewer:another-long-token   # turns login on
# MC_AUTO_APPROVE=0                  # 1 bypasses the reviewer gate (demo/eval only)
