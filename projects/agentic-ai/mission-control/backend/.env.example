# Mission Control backend settings. Copy to .env. Everything is optional:
# with no key the platform runs in offline mode. Full list: docs/configuration.md

# --- Model (live mode) --------------------------------------------------------
# Paste your key after the = (free key: https://aistudio.google.com/apikey). Empty = offline.
GOOGLE_API_KEY=
# MC_MODE=auto                           # auto | offline | live
# MC_PREMIUM_MODEL=gemini-flash-latest
# MC_CHEAP_MODEL=gemini-flash-lite-latest

# --- People ---------------------------------------------------------------------
# Unset = login off (the console says who is acting; nothing checks it).
# MC_OPERATORS=ana:analyst:long-random-token,rex:reviewer:another-long-token

# --- Ceilings ---------------------------------------------------------------------
# MC_MAX_COST_USD=0.25
# MC_MAX_WALLCLOCK_S=600
# MC_AUTO_APPROVE=0                      # 1 bypasses the reviewer gate (demo/eval only)

# --- Tracing ------------------------------------------------------------------------
# MC_OTEL_EXPORTER=console               # console | otlp (needs: uv sync --extra otel)
