# Dependencies
node_modules/

# package-lock.json IS committed, so every install gets the tested versions.
# Regenerate it from a clean tree (delete node_modules and the lockfile, then
# `npm install`): that records the native rollup/esbuild binaries for EVERY
# platform, which is what keeps `npm ci` working in Linux Docker and CI.

# Build output
dist/
dist-ssr/
*.local

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Playwright output
playwright-report/
test-results/
e2e/playwright-report/
e2e/test-results/
