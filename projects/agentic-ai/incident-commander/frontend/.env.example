# Base URL for the backend API.
# In dev, leave this unset to use the Vite proxy (/api -> http://localhost:8000).
# Set it explicitly only when the backend is hosted elsewhere.
VITE_API_URL=

# Optional. Sent as X-API-Key, to match the backend's IC_API_KEY.
# NOT a secret: anything starting with VITE_ is compiled into the public JavaScript
# bundle. It only keeps casual callers off a demo; use login (IC_AUTH_REQUIRED) for
# real access control.
VITE_API_KEY=
