# =============================================================================
# AI Incident Commander - configuration
# =============================================================================
# Every setting here is also served at GET /api/config, so an agent's real limits
# are inspectable at runtime rather than only documented.
#
# Most of these are worth flipping and re-running the evaluation to see what
# changes. See EXERCISES.md.

# -----------------------------------------------------------------------------
# Gemini (OPTIONAL - the app runs without it)
# -----------------------------------------------------------------------------
# With no key, the agents run in OFFLINE mode: a deterministic, rule-based agent
# that reads the same telemetry. The console shows an "Offline mode" banner so it
# is never mistaken for model reasoning. Add a key for real Gemini decisions.
# Free key at https://aistudio.google.com/apikey. GEMINI_API_KEY works too.
# Searched in this order, first hit wins:
#   backend/.env  ->  <project>/.env  ->  <monorepo root>/.env
GOOGLE_API_KEY=

# auto (default) = Gemini if a key is set, else offline
# gemini         = Gemini only; incidents are refused (503) without a key
# offline        = always the offline agent, even with a key
# IC_LLM_MODE=auto
# Pause per offline agent call, so you can watch the console animate.
# IC_OFFLINE_STEP_DELAY_S=0.8

# -----------------------------------------------------------------------------
# Model
# -----------------------------------------------------------------------------
# Google's -latest aliases keep working when a pinned version is retired.
# IC_MODEL_NAME=gemini-flash-latest
# Cheaper model for the classification-shaped agents (Triage, Verifier,
# Postmortem, Supervisor). ON by default - measured at 45% lower cost and 40%
# lower latency with no change in outcome. Set to "" to run everything on the
# strong tier and see the difference for yourself.
# IC_MODEL_FAST=gemini-flash-lite-latest
# IC_MODEL_TIERING=true
# IC_TEMPERATURE=0.2
# IC_LLM_TIMEOUT_S=60
# IC_LLM_MAX_RETRIES=2
# Consecutive failures that trip the circuit breaker for the whole process.
# IC_LLM_BREAKER_THRESHOLD=5
# IC_LLM_BREAKER_COOLDOWN_S=30

# -----------------------------------------------------------------------------
# Loop ceilings (the halt conditions)
# -----------------------------------------------------------------------------
# IC_MAX_ITERATIONS=6
# IC_MAX_COST_USD=0.50
# IC_MAX_WALLCLOCK_S=900
# How many extra read-only tool rounds the Diagnostician may request per incident.
# Set to 0 and `silent_config_drift` escalates instead of resolving.
# IC_MAX_EVIDENCE_ROUNDS=2
# Below this confidence the agent escalates rather than acting on a guess.
# IC_MIN_ACTION_CONFIDENCE=0.6

# -----------------------------------------------------------------------------
# Safety
# -----------------------------------------------------------------------------
# What the agent is permitted to run: sre-bot | sre-bot-restricted | read-only.
# An unrecognized value grants NO permissions (fail closed).
# IC_AGENT_ROLE=sre-bot
# Seconds to wait at the human gate before escalating. Without this, an operator
# who closes the tab strands the incident forever.
# IC_APPROVAL_TIMEOUT_S=300
# Auto-approve LOW/MEDIUM risk remediations (DEMO ONLY).
# High-risk actions (rollback, failover) ALWAYS require a human regardless.
# IC_AUTO_APPROVE=false
# Run the Critic agent to argue against each proposal before a human sees it.
# IC_CRITIC_ENABLED=true
# IC_MAX_CRITIC_VETOES=2
# Use the LLM Supervisor for routing. OFF by default: it costs one model call per
# iteration (~20s) and sanitize_route() clamps its answer to the same deterministic
# policy anyway. Turn it on to compare trajectories - see EXERCISES.md.
# IC_SUPERVISOR_ENABLED=false
# Remove injection-shaped text from telemetry rather than only flagging it.
# Set false to see what "detection without defence" actually looks like.
# IC_QUARANTINE_INJECTIONS=true
# Redact secret- and PII-shaped values before telemetry reaches a prompt.
# IC_REDACT_SENSITIVE=true

# -----------------------------------------------------------------------------
# Episodic memory
# -----------------------------------------------------------------------------
# IC_MEMORY_ENABLED=true
# IC_MEMORY_PATH=data/runbook_memory.json
# IC_MEMORY_TOP_K=3
# IC_MEMORY_MAX_ENTRIES=200

# -----------------------------------------------------------------------------
# Database + login  (BOTH OPTIONAL)
# -----------------------------------------------------------------------------
# Leave IC_DATABASE_URL empty and everything still works: incidents live in
# memory, runbook memory is a JSON file, and there is no login. That is the
# default and a fully supported way to run this.
#
# Set it and you get: incidents that survive a restart, dashboard figures computed
# across every run ever, and somewhere to keep users - which is what makes login
# possible at all.
#
#   docker compose up -d postgres      # brings one up on host port 5434
#
# Host port 5434, not 5432: a native Postgres install commonly owns 5432 and a
# second major version owns 5433. Connecting to the wrong one fails with a
# baffling "password authentication failed".
# IC_DATABASE_URL=postgresql+asyncpg://incident:incident@localhost:5434/incident_commander
# IC_DB_POOL_SIZE=5
# IC_DB_MAX_OVERFLOW=10

# Put the console behind a login. Needs IC_DATABASE_URL - auth with no user store
# is a locked door with no key, so this silently stays off without one.
# IC_AUTH_REQUIRED=false
# Signing secret. Must be >= 32 bytes and must not be the placeholder below;
# both are refused, because a known signing secret means anyone can mint an admin
# token. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# IC_JWT_SECRET=change-me-in-production
# IC_JWT_TTL_MINUTES=720
# Seeded ONLY into an empty users table, so a redeploy cannot silently reset a
# password you already changed. Leave the password empty and a random one is
# generated and printed ONCE in the backend log.
# IC_SEED_ADMIN_USER=admin
# IC_SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Engine
# -----------------------------------------------------------------------------
# loop  = the explicit async orchestrator (the teaching reference, default)
# graph = the equivalent langgraph StateGraph with a checkpointer
# IC_ENGINE=loop

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Loopback by default: with login off, anyone who can reach this port can approve.
# IC_HOST=127.0.0.1
# IC_PORT=8000
# IC_LOG_LEVEL=INFO
# IC_CORS_ORIGINS=http://localhost:5173
# Optional shared secret required in the X-API-Key header on mutating endpoints.
# Empty = open, which is fine for local dev and not for anything else.
# IC_API_KEY=
# Per-client-IP limit on mutating endpoints. 0 disables.
# IC_RATE_LIMIT_PER_MIN=60
# Terminal incidents retained in memory before the oldest are evicted.
# IC_MAX_RETAINED_INCIDENTS=50
