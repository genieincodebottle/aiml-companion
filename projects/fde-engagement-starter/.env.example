# Everything in this repo runs WITHOUT an API key. The scaffold, the customer
# environment, and every test in `make check` work offline on purpose, because a
# customer network is often the place where your key does not work.
#
# You only need a key for the parts where you call a model.

# Optional: Google Gemini (free tier at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# The mock legacy dispatch API
LEGACY_API_URL=http://localhost:8000

# MCP server auth. Two tokens on purpose: the whole point of the auth gate is that
# the read path cannot perform a write. Do not collapse these into one.
MCP_READ_TOKEN=dev-read-token
MCP_WRITE_TOKEN=dev-write-token

# Where the append-only audit log is written
AUDIT_LOG_PATH=./audit_log.jsonl

# Optional overrides
# FDE_MODEL_NAME=gemini-3.6-flash
# FDE_LOG_LEVEL=INFO
