# Copy to .env and fill in the key for whichever provider you configured in
# configs/base.yaml. You need exactly one of these, and you need NONE of them
# to run with `provider: stub`.
#
# configs/base.yaml holds knobs and is safe to commit. This file holds secrets
# and is in .gitignore. Keep that split.

# provider: gemini  (the default)
GOOGLE_API_KEY=

# provider: openai_compatible
# Works against OpenAI, vLLM, Ollama, Together, LM Studio - anything speaking
# the OpenAI chat-completions shape. Set base_url in configs/base.yaml.
# For a local server the key is usually ignored, but the SDK requires a value,
# so put any non-empty string.
OPENAI_API_KEY=

# provider: anthropic
ANTHROPIC_API_KEY=

# Optional. Guards against a runaway tuning loop billing you while you sleep.
# The run aborts when the estimated spend crosses this. See src/budget.py.
MAX_RUN_USD=5.00
