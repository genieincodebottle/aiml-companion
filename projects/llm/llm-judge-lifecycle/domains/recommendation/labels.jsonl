{"id": "ex-g03", "record_id": "rec-005", "artefact": "The Vellum Room is a locked-room mystery starring Marguerite Hale as the conservator.", "labels": {"grounded": "FAIL"}, "rationales": {"grounded": "The record names no cast. The performer is invented."}, "failure_modes": {"grounded": "unsupported_claim"}, "source": "expert"}
