# ---------------------------------------------------------------------------
# 1. LLM + embeddings.  One key powers extraction, embeddings and generation.
#    Free tier is enough for this project:  https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here

# ---------------------------------------------------------------------------
# 2. Neo4j.  These defaults match the bundled docker-compose.yml, so if you
#    run `docker compose up -d` you do not need to change anything here.
#
#    Using Neo4j Aura (free tier) instead?  Use the neo4j+s:// URI it gives you
#    and the generated password:
#      NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123
NEO4J_DATABASE=neo4j
